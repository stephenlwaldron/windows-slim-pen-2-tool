<Window x:Class="SlimPenHaptics.Ui.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add an app"
        Icon="pack://application:,,,/assets/app.ico"
        Width="480" Height="560" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20,16,20,16">
        <TextBlock DockPanel.Dock="Top" Text="Add an app" FontSize="20" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,12"
                   Text="Pick an app to give it its own feel, or to turn haptics off in it. Apps you've drawn in recently are listed first." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Browse…" Padding="14,6" Click="Browse_Click" />
            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add" Padding="22,6" IsDefault="True"
                    IsEnabled="False" Click="Add_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" />
        </DockPanel>

        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.7"
                   Text="No other apps are open. Open the app you want, or use Browse to find its .exe file." />

        <ListBox x:Name="AppList" SelectionChanged="AppList_SelectionChanged" MouseDoubleClick="AppList_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,4">
                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
