<Window x:Class="SlimPenHaptics.Ui.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new"
        Icon="pack://application:,,,/assets/app.ico"
        Width="520" SizeToContent="Height" MaxHeight="720" MinWidth="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="24,18,24,18">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,14"
                   Text="Slim Pen Haptics has been updated. Here is what changed." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Got it" Padding="22,6" IsDefault="True" IsCancel="True"
                    Click="Close_Click" />
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Open settings" Padding="14,6" Margin="0,0,8,0"
                    Click="Open_Click" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Filled in from Changelog -->
            <StackPanel x:Name="Items" />
        </ScrollViewer>
    </DockPanel>
</Window>
